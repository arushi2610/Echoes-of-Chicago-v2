rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Memory Validation Blueprint
    function isValidMemory(memory) {
      return memory.keys().hasAll(['title', 'story', 'neighborhood', 'author', 'era', 'category', 'coordinates', 'timestamp', 'isUnlocked', 'authorId']) &&
             memory.title is string && memory.title.size() <= 100 &&
             memory.story is string && memory.story.size() <= 5000 &&
             memory.neighborhood is string &&
             memory.author is string &&
             memory.era is string &&
             memory.category is string &&
             memory.authorId == request.auth.uid &&
             memory.coordinates is list && memory.coordinates.size() == 2 &&
             memory.coordinates[0] is number && memory.coordinates[1] is number &&
             memory.isUnlocked is bool &&
             (!('address' in memory) || memory.address is string) &&
             (!('audioUrl' in memory) || (memory.audioUrl is string && memory.audioUrl.size() <= 1000000)) &&
             (!('imageUrl' in memory) || (memory.imageUrl is string && memory.imageUrl.size() <= 1000000));
    }

    // 4. Memory Collection Rules
    match /memories/{memoryId} {
      allow read: if true; // Publicly visible community memories
      
      allow create: if isSignedIn() 
                    && isValidId(memoryId) 
                    && isValidMemory(request.resource.data)
                    && request.resource.data.timestamp == request.time;

      allow update: if isOwner(resource.data.authorId)
                    && isValidMemory(request.resource.data)
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.timestamp == resource.data.timestamp; // Immutable timestamp

      allow delete: if isOwner(resource.data.authorId);
    }

    // 5. User Profile and Collections
    match /users/{userId} {
      function isProfileOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isSignedIn();
      allow write: if isProfileOwner();

      match /savedMemories/{memoryId} {
        allow read: if isProfileOwner();
        allow create: if isProfileOwner() 
                      && isValidId(memoryId)
                      && request.resource.data.memoryId == memoryId
                      && request.resource.data.savedAt == request.time;
        allow delete: if isProfileOwner();
      }
    }
  }
}
